# Copia este fichero a .env (cp .env.example .env). Valores solo de demo: no usar en producción.
DEMO_MODE=true
ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_SEED=42
DEMO_CLOCK_START=2026-10-16T11:30:00
AGE_VERIFIER=fake
PAYMENT_PROVIDER=fake
LOCKER_TRANSPORT=sim
NOTIFIERS=inapp,email
SMTP_HOST=mailpit

# Conexión a la base de datos desde el host (en Docker, los servicios usan el host "db" internamente)
DATABASE_URL=postgresql+psycopg://mercat:mercat@127.0.0.1:5432/mercat

# Puertos publicados en el host
WEB_PORT=5173
API_PORT=8000
DB_PORT=5432
SMTP_PORT=1025

# Claves de demo (no son secretos reales)
SECRET_KEY=demo-only-secret-key-no-usar-fuera-de-localhost
PERSON_HASH_KEY=demo-only-person-hash-key
# Ubicación simulada del vecino (lat,lng): Plaça de Benimaclet
DEMO_LOCATION=39.4893,-0.3585
